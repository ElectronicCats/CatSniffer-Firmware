# Board-level Kconfig defaults for CatSniffer v2 (ATSAMD21E17A/E17D)

# Generate .uf2 output for drag-and-drop flashing
CONFIG_BUILD_OUTPUT_UF2=y

# Tell Zephyr to link at the code-partition offset (0x2000, after UF2 bootloader)
CONFIG_BOOTLOADER_BOSSA=y
CONFIG_BOOTLOADER_BOSSA_ADAFRUIT_UF2=y

# Explicitly configure DFLL48M from internal OSC8M, required for stable USB
CONFIG_SOC_ATMEL_SAMD_OSC8M=y
CONFIG_SOC_ATMEL_SAMD_OSC8M_AS_MAIN=y

# Also emit zephyr.hex (CI artifact)
CONFIG_BUILD_OUTPUT_HEX=y
